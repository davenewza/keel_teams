extend model User {
    fields {
        employeeCode Text? @unique
        isAdmin Boolean? @default(false)
    }

    actions {
        create newUser() with (employeeCode)
        update updateUserAsAdmin(id) {
            @set(user.isAdmin = true)
        }
        get getUser(id)
        list listUsers() {
            @permission(roles: [Dispatching, PaymentReceivables])
        }
    }

    @permission(
        expression: ctx.isAuthenticated,
        actions: [get, create, update, list]
    )
}

model Customer {
    fields {
        name Text?
        country Country
        region Text?
    }

    actions {
        get getCustomer(id)
        list listCustomer()
        create createCustomer() with (name?, country, region?)
    }

    @permission(
        expression: true,
        actions: [get, list, create]
    )
}

ledger CustomerAccount {
    position {
        customer Customer
    }

    amounts {
        amount Decimal
    }

    fields {
        reason Text
    }

    balances {
        balance @computed(SUM(customerAccount.amount))
    }

    @permission(
        expression: true,
        actions: [get, list, record, aggregate]
    )
}

enum Country {
    ZA
    UK
    EU
}

model Order {
    fields {
        orderNumber Text @unique
        customer Customer?
        status OrderStatus @default(OrderStatus.New)
        processedBy User
        items OrderItem[]
        total Decimal @computed(SUM(order.items.total))
        document File?
        isPaid Boolean @default(false)
    }

    measures {
        totalValue @computed(SUM(order.total))
    }

    actions {
        create createOrder() with (
            orderNumber,
            items.product.id,
            items.quantity,
            items.price,
            customer.country,
            customer.region?,
        ) {
            @permission(expression: ctx.isAuthenticated)
            @set(order.processedBy = ctx.identity.user)
        }
        get getOrder(id) {
            @permission(expression: ctx.isAuthenticated)
        }
        list listOrders() {
            @permission(roles: [Dispatching, PaymentReceivables])
        }
        update updateOrderToPaid(id) {
            @set(order.status = OrderStatus.Paid)
            @permission(roles: [PaymentReceivables])
        }
        update pickOrder(id) {
            @set(order.status = OrderStatus.Picked)
            @permission(roles: [Dispatching])
        }
        update dispatchOrder(id) {
            @set(order.status = OrderStatus.Dispatched)
            @permission(roles: [Dispatching])
        }
        aggregate salesByStatus() over (status) {
            @measures(totalValue)
        }
        aggregate salesByRegion() over (customer.country, customer.region) {
            @measures(totalValue)
        }
        // aggregate salesByProductName() over (items.product.name) {
        //     @measures(totalValue)
        // }
    }

    @permission(
        expression: true,
        actions: [create, list, get, aggregate]
    )
}

model OrderItem {
    fields {
        ledgerEntry StockEntry?
        order Order
        product Product
        quantity Number
        price Decimal
        total Decimal @computed(orderItem.quantity * orderItem.price)
        beenAllocated Boolean? @computed(orderItem.ledgerEntry.units != orderItem.quantity)
    }

    actions {
        list listOrderItems(order.id) {
            @permission(roles: [Dispatching, ProductManagement])
        }
    }

    @permission(
        expression: true,
        actions: [create, list, get]
    )
}

model Product {
    fields {
        stockBalance StockBalance[]
        actualStock Number @computed(SUM(product.stockBalance.onHand))
        sku Text @unique
        title Text
        price Decimal
        stockIn Number @computed(SUMIF(product.purchases.quantity, product.purchases.status == ProcurementStatus.Received))
        stockOut Number @computed(SUM(product.sales.quantity))
        stockAvailable Number @computed(product.stockIn - product.stockOut)
        sales OrderItem[]
        purchases Procurement[]
        totalUnitsSold Number @computed(SUM(product.sales.quantity))
        totalValueSold Decimal @computed(SUM(product.sales.total))
    }

    measures {
        totalUnits @computed(SUM(product.totalUnitsSold))
        averageValue @computed(SUM(product.totalValueSold) / SUM(product.totalUnitsSold))
    }

    actions {
        create createProduct() with (sku, title, price) {
            @permission(roles: [ProductManagement])
        }
        get getProduct(id) {
            @permission(expression: ctx.isAuthenticated)
            @permission(roles: [Dispatching])
        }
        list listProducts() {
            @permission(expression: ctx.isAuthenticated)
            //@permission(roles: [Dispatching, ProductManagement])
        }
        aggregate salesByProduct(price?) {
            @dimensions(sku)
            @measures(
                totalUnits,
                averageValue
            )
            // @dimensions(
            //     sku,
            //     title
            // )
            //@orderBy(totalUnits: asc) //,
            //sku: asc
        }
    }

    @permission(
        roles: [ProductManagement],
        actions: [create, list, get, aggregate]
    )
}

model Procurement {
    fields {
        product Product
        quantity Number
        status ProcurementStatus @default(ProcurementStatus.Draft)
    }

    actions {
        create createProcurement() with (product.id, quantity)
        get getProcurement(id)
        list listProcurement(product.id?)
        update updateProcurementStatus(id) with (status)
    }

    @permission(
        roles: [Procurement],
        actions: [create, get, list, update]
    )
}

enum ProcurementStatus {
    Draft
    Ordered
    Received
}

enum OrderStatus {
    New
    Paid
    Picked
    Dispatched
}

task PayAccount {
    @permission(roles: [PaymentReceivables])
}

flow ReconcileBankStatement {
    @permission(roles: [PaymentReceivables])
}

role Dispatching {
}

role PaymentReceivables {
}

role ProductManagement {
}

role Procurement {
}

team Accounts {
    roles {
        PaymentReceivables
    }
}

team Outbound {
    roles {
        Dispatching
        ProductManagement
    }
}

team Management {
    roles {
        Dispatching
        PaymentReceivables
        ProductManagement
        Procurement
    }
}

team Thing {
}

ledger Stock {
    position {
        product Product
        location Loc
    }

    amounts {
        units Number @strict(
            product,
            stock.reason == "Transfer"
        )
    }

    fields {
        reason Text
        order OrderItem?
    }

    balances {
        onHand @computed(SUM(stock.units))
        // allocated @computed(SUMIF(stock.units, stock.reason == "Picked"))
        // available @computed(stock.onHand - stock.allocated)
    }

    measures {
        movements @computed(COUNT())
        total @computed(SUM(stock.units))
        picked @computed(SUMIF(stock.units, stock.reason == "Picked"))
        averageMovement @computed(AVG(stock.units))
        // Reaches the item the entry is positioned on: a per-entry calculation, aggregated.
        valueMoved @computed(SUM(stock.units * stock.product.price))
    }

    actions {
        aggregate stockByItem(product.id?) over (product) {
            @measures(total)
        }
        // aggregate stockBalances(product.id?, location?) {
        //     @measures(onHand)
        // }
    }

    @permission(
        roles: [PaymentReceivables],
        actions: [get, record, list, aggregate]
    )
}

enum Loc {
    Receiving
    Available
}
